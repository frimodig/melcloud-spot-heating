# Copy to web.env (chmod 600). Read by the page's service only, never by run.sh: the page's process
# must not have the MELCloud password. Tailscale login=nickname pairs; the nickname is shown on the page.
WEB_USERS='first@example.com=Anna,second@example.com=Ben'
# The house's location, the same two lines as in .env: the page's chart uses them for the forecast.
# WEATHER_LATITUDE='60.17'    # your location, e.g. from a map; without it weather and sun stay off
# WEATHER_LONGITUDE='24.94'
# With "entsoe" in [prices] sources, the same token as in .env: the page plans its chart itself.
# ENTSOE_TOKEN='your-token'
