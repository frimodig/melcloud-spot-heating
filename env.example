# Copy to .env, then: chmod 600 .env
# Keep the single quotes: passwords with ? $ ; & ] etc. break the shell otherwise.
# A password containing a single quote cannot use this form; change it or escape as '\''.
MELCLOUD_EMAIL='you@example.com'
MELCLOUD_PASSWORD='change-me'
# The house's location for the weather forecast (kept out of config.toml). Both or neither.
# WEATHER_LATITUDE='60.17'    # your location, e.g. from a map; without it weather and sun stay off
# WEATHER_LONGITUDE='24.94'
# Optional: the ENTSO-E Transparency Platform token, for [prices] source = "entsoe".
# ENTSOE_TOKEN='your-token'
# Optional dead-man alert (Healthchecks.io ping URL); the controller pings it after each healthy run.
# HEARTBEAT_URL='https://hc-ping.com/your-check-uuid'
